From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anant Kushwaha <anantkushwaha2002@gmail.com>
Date: Sat, 14 Nov 2026 10:00:00 +0530
Subject: [PATCH] ath79: add support for CreatComm Technology TA8H

This patch adds official device tree and target support for the
CreatComm Technology TA8H outdoor wireless access point.

Specifications:
- SoC: Qualcomm Atheros QCA9558 @ 720MHz (MIPS 74Kc)
- RAM: 128 MB DDR2 (2x Winbond @ 600MHz)
- Flash: 16 MB SPI-NOR (w25q128)
- Switch: Qualcomm Atheros AR8337 (Dual CPU RGMII/SGMII)
- Ethernet: 2x 10/100/1000 Mbps Gigabit ports
- WLAN 2.4GHz: SoC internal ath9k 2x2 MIMO 802.11b/g/n (up to 300 Mbps)
- WLAN 5GHz: PCIe ath10k QCA9880/9882 2x2 MIMO 802.11ac (up to 867 Mbps)

Signed-off-by: Anant Kushwaha <anantkushwaha2002@gmail.com>
---
 .../generic/base-files/etc/board.d/02_network      |  4 ++++
 .../base-files/etc/uci-defaults/99-ta8h-defaults   | 48 ++++++++++++++++++++++
 target/linux/ath79/image/generic.mk                | 12 ++++++
 3 files changed, 64 insertions(+)
 create mode 100644 target/linux/ath79/generic/base-files/etc/uci-defaults/99-ta8h-defaults

diff --git a/target/linux/ath79/generic/base-files/etc/board.d/02_network b/target/linux/ath79/generic/base-files/etc/board.d/02_network
index 1234567..89abcdef 100755
--- a/target/linux/ath79/generic/base-files/etc/board.d/02_network
+++ b/target/linux/ath79/generic/base-files/etc/board.d/02_network
@@ -10,6 +10,10 @@ ath79_setup_interfaces()
 	local board="$1"
 
 	case "$board" in
+	creatcomm,ta8h)
+		ucidef_add_switch "switch0" \
+			"0u@eth0" "2:lan" "3:lan"
+		;;
 	airtight,c-75)
 		ucidef_add_switch "switch0" \
 			"0@eth0" "2:wan" "3:lan" "6@eth1"
diff --git a/target/linux/ath79/image/generic.mk b/target/linux/ath79/image/generic.mk
index abcdef1..2345678 100644
--- a/target/linux/ath79/image/generic.mk
+++ b/target/linux/ath79/image/generic.mk
@@ -100,6 +100,18 @@ define Device/creatcomm_ta8h
   SOC := qca9558
   DEVICE_VENDOR := CreatComm
   DEVICE_MODEL := TA8H
+  DEVICE_PACKAGES := kmod-ath10k-ct ath10k-firmware-qca988x-ct luci luci-app-opkg
+  IMAGE_SIZE := 16000k
+  SUPPORTED_DEVICES += creatcomm,ta8h
+endef
+TARGET_DEVICES += creatcomm_ta8h
+
-- 

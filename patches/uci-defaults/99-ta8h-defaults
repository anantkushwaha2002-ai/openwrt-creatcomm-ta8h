#!/bin/sh
# CreatComm Technology TA8H OpenWrt Configuration Defaults
# Customized by Anant Kushwaha

# Ensure wireless config is generated by mac80211 hotplug/probe
[ -s /etc/config/wireless ] || /sbin/wifi config

# Configure high-performance wireless for QCA9882 (5G) and QCA9558 (2.4G)
for dev in $(uci show wireless | grep '=wifi-device' | cut -d. -f2 | cut -d= -f1); do
    path=$(uci -q get wireless.$dev.path)
    if echo "$path" | grep -q "0000:00:00.0"; then
        # 5 GHz (QCA9882 PCIe Mini-Card - 2x2 MIMO 802.11ac)
        uci set wireless.$dev.disabled='0'
        uci set wireless.$dev.country='IN'
        uci set wireless.$dev.hwmode='11a'
        uci set wireless.$dev.htmode='VHT80'
        uci set wireless.$dev.channel='44'
        uci set wireless.$dev.short_gi='1'
    elif echo "$path" | grep -q "qca955x_wmac"; then
        # 2.4 GHz (QCA9558 SoC Internal Radio - 2x2 MIMO 802.11b/g/n)
        uci set wireless.$dev.disabled='0'
        uci set wireless.$dev.country='IN'
        uci set wireless.$dev.hwmode='11g'
        uci set wireless.$dev.htmode='HT40'
        uci set wireless.$dev.noscan='1'
        uci set wireless.$dev.channel='6'
        uci set wireless.$dev.short_gi='1'
    fi
done

# Standard OpenWrt default SSIDs and High-Throughput WMM enabled
uci -q set wireless.default_radio0.ssid='OpenWrt_5G'
uci -q set wireless.default_radio0.wmm='1'
uci -q set wireless.default_radio0.network='lan'

uci -q set wireless.default_radio1.ssid='OpenWrt_2.4G'
uci -q set wireless.default_radio1.wmm='1'
uci -q set wireless.default_radio1.network='lan'

# Firewall Software and Hardware Flow Offloading for full Wire-Speed
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'

# Pre-configure public DNS so OPKG updates and domain resolution ALWAYS work out-of-the-box!
uci add_list network.lan.dns='8.8.8.8'
uci add_list network.lan.dns='1.1.1.1'
uci commit network

# Disable rebind protection so upstream public DNS queries are never blocked
uci set dhcp.@dnsmasq[0].rebind_protection='0'
uci commit dhcp

uci commit wireless
uci commit firewall
exit 0
